								continue
								end
							end
						end
						FovRadius = Dist
						TargetPlayer = NewPlayer
						TargetPart = Part
					end
				end
			end

			Script.Target.Player = TargetPlayer
			Script.Target.PlayerPart =  TargetPart
			SilentAimTick = tick()

		end
	end


	local update = function()
		local Value = Axis.Main.SilentAim.Enabled

		for i=1,  #hearthbeat do
			if hearthbeat[i] == SilentAimFunc then
				table.remove(hearthbeat, i)
				break
			end
		end

		if Value then
			hearthbeat[#hearthbeat + 1] = SilentAimFunc
		end


	end

	Creat__Con(Signals['SilentAim__Onchanged'], update)
end


