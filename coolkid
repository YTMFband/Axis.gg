function IsPlayerDown(p1 : Player)

    if not p1.Character then
        return false
    end
    
    if not p1.Character:FindFirstChild('BodyEffects') then
        return false
    end

    if  p1.Character:FindFirstChild('BodyEffects')['K.O'].Value then
        return true
    end

    return false
end


function CrewCheck(p1, p2)
	local p1Information = p1:FindFirstChild('DataFolder'):FindFirstChild('Information')
	local p2Information = p2:FindFirstChild('DataFolder'):FindFirstChild('Information')

	if not p1Information:FindFirstChild('Crew') then
		return false
	end

	if not p2Information:FindFirstChild('Crew') then
		return false
	end

	if p1Information:FindFirstChild('Crew').Value == p2Information:FindFirstChild('Crew').Value then
		return true
	end

	return false
end


