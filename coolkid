function DrawFov(Thickness, NumSide, Radius, Color, Transparency)
    local Default = Drawing.new('Circle')
    Default.Color = Color
    Default.Thickness = Thickness
    Default.Visible = false
    Default.Transparency = Transparency or 1
    Default.Radius = Radius
    Default.NumSide = NumSide
    return Default
end

